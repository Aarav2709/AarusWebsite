---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | AarusPortfolio">
  <main id="main-content" class="page">
    <section class="contact">

      <header class="header reveal">
        <h1>Contact</h1>

        <p>
          Have a question, idea, or want to get in touch?
        </p>
      </header>

      <form
        class="contact-form reveal"
        action="mailto:aaravgupta2709@proton.me"
        method="post"
        enctype="text/plain"
      >

        <input
          type="text"
          name="name"
          placeholder="Your name"
          required
        />

        <input
          type="email"
          name="email"
          placeholder="Your email"
          required
        />

        <textarea
          name="message"
          rows="5"
          placeholder="Your message"
          required
        ></textarea>

        <button type="submit">
          Send message ↗
        </button>

      </form>

    </section>
  </main>
</Layout>

<style>
.page {
  min-height:100vh;
  padding:8rem var(--container-padding) 4rem;
}

.contact {
  max-width:42rem;
  margin:0 auto;
  text-align:center;
}

.header {
  margin-bottom:3rem;
}

h1 {
  margin:0;
  color:var(--accent-color);
  font-family:var(--font-display);
  font-size:clamp(3rem,7vw,5rem);
  letter-spacing:-.065em;
  line-height:.95;
}

.header p {
  margin-top:1rem;
  color:var(--secondary-text);
  font-size:1.1rem;
}

.contact-form {
  display:flex;
  flex-direction:column;
  gap:1.3rem;
  align-items:center;
}

input,
textarea {
  width:100%;
  padding:.8rem 0;
  border:none;
  border-bottom:1px solid var(--border-color);
  background:none;
  color:var(--primary-text);
  font-family:var(--font-family);
  font-size:1rem;
  text-align:left;
}

input:focus,
textarea:focus {
  outline:none;
  border-color:var(--accent-color);
}

textarea {
  resize:none;
}

input::placeholder,
textarea::placeholder {
  color:var(--tertiary-text);
}

button {
  margin-top:.5rem;
  width:fit-content;
  padding:.3rem 0;
  border:none;
  border-bottom:1px dashed var(--accent-color);
  background:none;
  color:var(--accent-color);
  font-family:var(--font-display);
  font-size:1rem;
  cursor:pointer;
  transition:.2s ease;
}

button:hover {
  color:var(--primary-text);
}

@media(max-width:600px) {
  .page {
    padding-top:6rem;
  }
}
</style>
