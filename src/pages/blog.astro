---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const sortedPosts = posts.sort(
  (a,b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog | AarusPortfolio">
  <main class="page">
    <section class="blog">

      <header class="header reveal">
        <h1>Blog</h1>

        <p>
          Thoughts, devlogs, experiments, and things I learn while building.
        </p>
      </header>

      <div class="posts">

        {
          sortedPosts.map((post,index)=>(
            <article class="post reveal">

              <a href={`/blog/${post.id.replace(".md","")}`}>

                <span class="number">
                  {String(index+1).padStart(2,"0")}
                </span>

                <h2>
                  {post.data.title}
                </h2>

                <p>
                  {post.data.description}
                </p>

                <div class="metadata">

                  <time>
                    {post.data.date.toDateString()}
                  </time>

                  {
                    post.data.tags?.map((tag)=>(
                      <span>
                        #{tag}
                      </span>
                    ))
                  }

                </div>

              </a>

            </article>
          ))
        }

      </div>

    </section>
  </main>
</Layout>

<style>
.page {
  min-height:100vh;
  padding:8rem var(--container-padding) 5rem;
}

.blog {
  max-width:52rem;
  margin:0 auto;
}

.header {
  text-align:center;
  margin-bottom:4rem;
}

h1 {
  margin:0;
  color:var(--accent-color);
  font-size:clamp(3rem,7vw,5rem);
  letter-spacing:-.06em;
}

.header p {
  margin-top:1rem;
  color:var(--secondary-text);
  font-size:1.1rem;
}

.posts {
  display:flex;
  flex-direction:column;
}

.post {
  border-bottom:1px solid var(--border-color);
}

.post a {
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  padding:3rem 0;
  text-decoration:none;
}

.number {
  color:var(--accent-color);
  font-size:.85rem;
  margin-bottom:1rem;
}

h2 {
  color:var(--primary-text);
  font-size:clamp(1.6rem,3vw,2.2rem);
  letter-spacing:-.04em;
}

.post p {
  margin-top:.8rem;
  color:var(--secondary-text);
  line-height:1.7;
  max-width:42rem;
}

.metadata {
  display:flex;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  gap:.6rem;
  margin-top:1.2rem;
}

.metadata time,
.metadata span {
  padding:.35rem .7rem;
  border-radius:.6rem;
  border:1px solid var(--border-color);
  color:var(--secondary-text);
  font-size:.85rem;
}

.post:hover h2 {
  color:var(--accent-color);
}

.post {
  transition:var(--transition-smooth);
}

.post:hover {
  transform:translateY(-4px);
}

@media(max-width:768px){
  .page {
    padding-top:6rem;
  }
}
</style>
