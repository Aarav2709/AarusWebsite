---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main id="main-content">
    <section class="hero">
      <h1 class="hero-title">
        Aarav<br />
        Gupta
      </h1>

      <p class="hero-subtitle">
        15 year old developer building software, games, and things I find
        interesting.
      </p>

      <div class="links hero-links">
        <a href="mailto:aaravgupta2709@proton.me" aria-label="Mail">
          <svg viewBox="0 0 24 24">
            <path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/>
          </svg>
        </a>

        <a
          href="https://github.com/Aarav2709"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.05c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.48.99.11-.77.42-1.3.76-1.6-2.66-.3-5.46-1.33-5.46-5.92 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.6-2.8 5.61-5.47 5.91.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/>
          </svg>
        </a>

        <a
          href="https://linkedin.com/in/aarav2709"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24">
            <path fill="currentColor" d="M6.94 8.5A1.94 1.94 0 1 1 7 4.62a1.94 1.94 0 0 1-.06 3.88ZM5.2 9.8h3.5V20H5.2V9.8Zm5.7 0h3.35v1.39h.05c.47-.89 1.62-1.83 3.34-1.83 3.57 0 4.23 2.35 4.23 5.4V20h-3.5v-4.65c0-1.11 0-2.54-1.55-2.54s-1.78 1.2-1.78 2.46V20h-3.5V9.8Z"/>
          </svg>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
.hero {
  min-height:100vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}

.hero-title {
  font-size:clamp(5rem,12vw,9rem);
  line-height:.85;
  margin:0;
  font-family:var(--font-display);
  color:var(--accent-color);
  opacity:0;
  transform:translateY(30px);
  filter:blur(8px);
  animation:heroEnter .9s cubic-bezier(.22,1,.36,1) forwards;
}

.hero-subtitle {
  margin-top:2rem;
  font-size:1.1rem;
  color:var(--secondary-text);
  max-width:35rem;
  line-height:1.7;
  opacity:0;
  transform:translateY(25px);
  animation:heroFade .8s cubic-bezier(.22,1,.36,1) .25s forwards;
}

.links {
  display:flex;
  gap:1.2rem;
  margin-top:1.8rem;
  opacity:0;
  transform:translateY(20px);
  animation:heroFade .8s cubic-bezier(.22,1,.36,1) .45s forwards;
}

.links a {
  width:2.8rem;
  height:2.8rem;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--secondary-text);
  border:1px solid var(--border-color);
  border-radius:50%;
  transition:.2s ease;
}

.links svg {
  width:1.25rem;
  height:1.25rem;
}

.links a:hover {
  color:var(--accent-color);
  border-color:var(--accent-color);
}

@keyframes heroEnter {
  from {
    opacity:0;
    transform:translateY(30px);
    filter:blur(8px);
  }

  to {
    opacity:1;
    transform:translateY(0);
    filter:blur(0);
  }
}

@keyframes heroFade {
  from {
    opacity:0;
    transform:translateY(25px);
  }

  to {
    opacity:1;
    transform:translateY(0);
  }
}

@media(prefers-reduced-motion:reduce) {
  .hero-title,
  .hero-subtitle,
  .hero-links {
    animation:none;
    opacity:1;
    transform:none;
    filter:none;
  }
}

@media(max-width:768px) {
  .hero h1 {
    font-size:clamp(4rem,18vw,6rem);
  }

  .links {
    gap:1rem;
  }
}
</style>
