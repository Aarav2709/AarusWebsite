---
import { getCollection, render } from "astro:content";
import BlogHeader from "../../components/BlogHeader.astro";
import BlogMeta from "../../components/BlogMeta.astro";
import MarkdownContent from "../../components/MarkdownContent.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | AarusPortfolio`} description={post.data.description}>
  <main id="main-content" class="page">
    <article class="article">
      <BlogHeader title={post.data.title} description={post.data.description} />

      <BlogMeta date={post.data.date} />

      <div class="divider" aria-hidden="true"></div>

      <MarkdownContent>
        <Content />
      </MarkdownContent>

      <footer class="articleFooter">
        <p>Thanks for reading.</p>
        <a href="/blog">Back to all posts</a>
      </footer>
    </article>
  </main>
</Layout>

<style>
.page {
  min-height: 100vh;
  padding: 8rem var(--container-padding) 6rem;
}

.article {
  max-width: 68rem;
  margin: 0 auto;
}

.divider {
  max-width: 48rem;
  height: 1px;
  margin: 3rem auto 0;
  background: linear-gradient(90deg, transparent, var(--border-color) 12%, var(--border-color) 88%, transparent);
}

.articleFooter {
  max-width: 48rem;
  margin: 5rem auto 0;
  padding-top: 1.75rem;
  border-top: 1px solid var(--border-color);
  text-align: center;
}

.articleFooter p {
  margin: 0;
  color: var(--secondary-text);
}

.articleFooter a {
  display: inline-block;
  margin-top: 0.9rem;
  color: var(--accent-color);
}

.articleFooter a:hover {
  color: var(--primary-text);
}

@media (max-width: 768px) {
  .page {
    padding-top: 6.5rem;
  }

  .divider {
    margin-top: 2.5rem;
  }

  .articleFooter {
    margin-top: 4rem;
  }
}
</style>
