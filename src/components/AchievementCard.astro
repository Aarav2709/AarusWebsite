---
interface Props {
  title: string;
  description: string;
  detail?: string;
  image?: string;
  imageAlt?: string;
  imageHref?: string;
  index?: number;
}

const {
  title,
  description,
  detail,
  image,
  imageAlt = "",
  imageHref,
  index = 0,
} = Astro.props;
---

<article class="achievementCard reveal">
  {image && (
    <a
      class="preview"
      href={imageHref ?? image}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View ${title}`}
    >
      <img src={image} alt={imageAlt} loading="lazy" />
      <span>View image</span>
    </a>
  )}

  <div class="content">
    <span class="number">{String(index + 1).padStart(2, "0")}</span>
    {detail && <p class="detail">{detail}</p>}
    <h2>{title}</h2>
    <p class="description">{description}</p>
  </div>
</article>

<style>
.achievementCard {
  display: flex;
  min-width: 0;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--border-color);
  border-radius: var(--rounded-corner);
  background: var(--glass-bg);
  box-shadow: var(--edge-highlight), var(--shadow);
  transition: var(--transition-bounce);
}

.achievementCard:hover {
  border-color: color-mix(in srgb, var(--accent-color) 55%, transparent);
  box-shadow: var(--edge-highlight), var(--shadow-raised);
  transform: translateY(-0.35rem);
}

.preview {
  position: relative;
  display: block;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-bottom: 1px solid var(--border-color);
  background: var(--bg-panel-strong);
}

.preview img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.preview::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 42%, rgba(17, 23, 24, 0.78));
  content: "";
}

.preview span {
  position: absolute;
  right: 1rem;
  bottom: 0.8rem;
  z-index: 1;
  color: var(--primary-text);
  font-size: 0.8rem;
  font-weight: 700;
}

.preview:hover img {
  transform: scale(1.04);
}

.content {
  display: flex;
  min-height: 15rem;
  flex: 1;
  flex-direction: column;
  padding: 1.4rem;
}

.number {
  color: var(--accent-color);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.detail {
  margin: 0.65rem 0 0;
  color: var(--tertiary-text);
  font-size: 0.78rem;
  line-height: 1.45;
}

h2 {
  margin: 0.65rem 0 0;
  color: var(--primary-text);
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 2.8vw, 1.8rem);
  letter-spacing: -0.04em;
  line-height: 1.08;
}

.description {
  margin: 0.85rem 0 0;
  color: var(--secondary-text);
  font-size: 0.95rem;
  line-height: 1.68;
}
</style>
