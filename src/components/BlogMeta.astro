---
interface Props {
  date: Date;
}

const { date } = Astro.props;
const formatDate = (value: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(value);
---

<div class="blogMeta">
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
</div>

<style>
.blogMeta {
  margin-top: 1.5rem;
  color: var(--secondary-text);
  font-size: 0.94rem;
  text-align: center;
}
</style>
