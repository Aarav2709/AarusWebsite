---
interface Props {
  title: string;
  description: string;
  tech: string[];
  github?: string;
  live?: string;
  previewImage?: string;
  previewAlt?: string;
  stars?: number;
  index: number;
}

const {
  title,
  description,
  tech,
  github,
  live,
  previewImage,
  previewAlt,
  stars = 0,
  index,
} = Astro.props;

const resolvedPreviewAlt = previewAlt ?? `${title} preview`;
---

<article
  class="project slide-up"
  style={`animation-delay: ${index * 0.08}s`}
>

  {
    previewImage && (
      <div class="preview">
        <img src={previewImage} alt={resolvedPreviewAlt} />
      </div>
    )
  }


  <div class="project-content">

    <div class="project-tech">
      {tech.join(" • ")}
    </div>


    <h2>
      {title}
    </h2>


    <p>
      {description}
    </p>


    <div class="project-links">

      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
          >
            source ↗
          </a>
        )
      }


      {
        live && (
          <a
            href={live}
            target="_blank"
            rel="noopener noreferrer"
          >
            live ↗
          </a>
        )
      }


      {
        github && (
          <span class="stars">
            ★ {stars}
          </span>
        )
      }


      {
        previewImage && (
          <button
            type="button"
            class="preview-button"
            data-preview-open
            data-preview-src={previewImage}
            data-preview-alt={resolvedPreviewAlt}
            data-preview-title={`${title} preview`}
          >
            preview
          </button>
        )
      }

    </div>

  </div>

</article>


<style>

.project {

  padding: 2.5rem 0;

  border-bottom: 1px solid var(--border-color);

  transition: var(--transition-smooth);

}


.project:hover {

  transform:translateX(8px);

}



.preview {

  margin-bottom:1.5rem;

}



.preview img {

  width:100%;

  max-height:350px;

  object-fit:cover;

  border-radius:1rem;

}



.project-content {

  max-width:50rem;

}



.project-tech {

  font-family:var(--font-mono);

  font-size:.75rem;

  text-transform:uppercase;

  letter-spacing:.12em;

  color:var(--secondary-text);

  margin-bottom:.9rem;

}



h2 {

  margin:0;

  color:var(--accent-color);

  font-size:clamp(1.7rem,3vw,2.3rem);

  font-weight:600;

  letter-spacing:-0.03em;

  line-height:1.1;

}



p {

  margin-top:1rem;

  color:var(--secondary-text);

  font-size:1.05rem;

  line-height:1.75;

  max-width:46rem;

}



.project-links {

  display:flex;

  align-items:center;

  gap:1rem;

  margin-top:1.5rem;

}



.project-links a,
.preview-button {

  color:var(--primary-text);

  font-size:.9rem;

  text-decoration:none;

  background:none;

  border:none;

  padding:0;

  cursor:pointer;

  font-family:var(--font-family);

}



.project-links a:hover,
.preview-button:hover {

  color:var(--accent-color);

}



.stars {

  color:var(--secondary-text);

  font-size:.9rem;

}



@media(max-width:768px){

  .project {

    padding:2rem 0;

  }


  .project-links {

    flex-wrap:wrap;

  }

}

</style>
