---
interface Props {
  title: string;
  description: string;
  tech: string[];
  github?: string;
  live?: string;
  buttons?: {
    text: string;
    url: string;
  }[];
  previewImage?: string;
  previewAlt?: string;
  stars?: number;
  index: number;
}

const {
  title,
  description,
  tech,
  github,
  live,
  buttons = [],
  previewImage,
  previewAlt,
  stars = 0,
  index,
} = Astro.props;

const resolvedPreviewAlt = previewAlt ?? `${title} preview`;
---

<article
  class="project reveal"
  style={`transition-delay:${index * 80}ms`}
>
  {previewImage && (
    <div class="preview">
      <img src={previewImage} alt={resolvedPreviewAlt} />
    </div>
  )}

  <div class="project-content">
    <div class="project-tech">
      {tech.join(" • ")}
    </div>

    <h2>{title}</h2>

    <p>{description}</p>

    <div class="project-links">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer">
          Source ↗
        </a>
      )}

      {live && (
        <a href={live} target="_blank" rel="noopener noreferrer">
          Live ↗
        </a>
      )}

      {buttons.map((button) => (
        <a
          href={button.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {button.text} ↗
        </a>
      ))}

      {github && (
        <span class="stars">
          ★ {stars}
        </span>
      )}

      {previewImage && (
        <button
          type="button"
          class="preview-button"
          data-preview-open
          data-preview-src={previewImage}
          data-preview-alt={resolvedPreviewAlt}
          data-preview-title={`${title} preview`}
        >
          Preview
        </button>
      )}
    </div>
  </div>
</article>

<style>
.project {
  padding: 3rem 0;
  border-bottom: 1px solid var(--border-color);
  transition:
    transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.35s ease;
}

.project:hover {
  border-color: var(--accent-color);
}

.project:hover .project-content {
  transform: translateX(8px);
}

.preview {
  margin-bottom: 1.5rem;
}

.preview img {
  width: 100%;
  max-height: 350px;
  object-fit: cover;
  border-radius: 1rem;
}

.project-content {
  max-width:55rem;
  margin:0 auto;
  text-align:center;
  transition:transform .35s cubic-bezier(0.22,1,0.36,1);
}

.project-tech {
  font-size:0.85rem;
  font-weight:500;
  letter-spacing:0.05em;
  color:var(--tertiary-text);
  margin-bottom:1rem;
}

h2 {
  margin:0;
  color:var(--primary-text);
  font-size:clamp(1.5rem,3vw,2rem);
  font-weight:500;
  line-height:1.2;
}

p {
  margin:1rem auto 0;
  color:var(--secondary-text);
  line-height:1.7;
  max-width:48rem;
}

.project-links {
  display:flex;
  justify-content:center;
  align-items:center;
  gap:1rem;
  margin-top:1.5rem;
  flex-wrap:wrap;
}

.project-links a,
.preview-button {
  color:var(--primary-text);
  font-size:0.9rem;
  text-decoration:none;
  background:none;
  border:none;
  cursor:pointer;
  transition:color .25s ease;
}

.project-links a:hover,
.preview-button:hover {
  color:var(--accent-color);
}

.stars {
  color:var(--secondary-text);
  font-size:0.9rem;
}

@media(max-width:768px) {
  .project {
    padding:2rem 0;
  }
}
</style>
